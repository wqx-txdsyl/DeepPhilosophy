        "existingPunctuationDifferences": [
          {
            "source": "",
            "current": "。",
            "sourceContext": "如是。唯優波離。妄想是垢無妄想是淨。顛倒是垢。無"
          }
        ],
        "actualSourceSmallSupNotes": []
      },
      {
        "chapter": 4,
        "fixedUrl": "https://zh.wikisource.org/w/index.php?oldid=8737997",
        "htmlSha256": "bfacf3b1ebb5f1b685d0cd6e9a66808f7c01ba2ec53e22835c6796ba847eb1d6",
        "sourceBodyElements": 4,
        "currentReadingBlocks": 4,
        "allSourceHanPreserved": true,
        "existingPunctuationDifferences": [
          {
            "source": "。",
            "current": "",
            "sourceContext": "何。憶念我昔住於靜室。時。魔波旬從萬二千天女。狀如"
          },
          {
            "source": "",
            "current": "。",
            "sourceContext": "與我。如我應受。魔即驚懼念。維摩詰將無惱我。欲隱"
          },
          {
            "source": "。",
            "current": "",
            "sourceContext": "我。如我應受。魔即驚懼念。維摩詰將無惱我。欲隱形去"
          },
          {
            "source": "",
            "current": "。",
            "sourceContext": "詰問疾。善德白佛言。世尊我不堪任詣彼問疾。所以者"
          },
          {
            "source": "。",
            "current": "",
            "sourceContext": "身命財起三堅法。於六念中。起思念法。於六和敬起質直"
          }
        ],
        "actualSourceSmallSupNotes": []
      },
      {
        "chapter": 5,
        "fixedUrl": "https://zh.wikisource.org/w/index.php?oldid=2305865",
        "htmlSha256": "73dc32cc5e709afbf30d626567e664ed7001d6fd721e1b09ad1afad01310f6f2",
        "sourceBodyElements": 19,
        "currentReadingBlocks": 19,
        "allSourceHanPreserved": true,
        "existingPunctuationDifferences": [
          {
            "source": "。",
            "current": "",
            "sourceContext": "竟寂滅。說悔先罪而不說入。於過去。以己之疾愍於彼疾"
          },
          {
            "source": "。",
            "current": "",
            "sourceContext": "解彼縛無有是處。若自無縛。能解彼縛斯有是處。是故菩"
          },
          {
            "source": "。",
            "current": "",
            "sourceContext": "方便慧縛。謂菩薩以愛見心。莊嚴佛土成就眾生。於空無"
          }
        ],
        "actualSourceSmallSupNotes": []
      },
      {
        "chapter": 6,
        "fixedUrl": "https://zh.wikisource.org/w/index.php?oldid=2305867",
