        "allSourceHanPreserved": true,
        "existingPunctuationDifferences": [
          {
            "source": "",
            "current": "。",
            "sourceContext": "起故。行不二慈內外不合故行不壞慈畢竟盡故。行堅固"
          },
          {
            "source": "",
            "current": "。",
            "sourceContext": "又問。善不善孰為本。答曰身為本。又問。身孰為本。"
          },
          {
            "source": "",
            "current": "。",
            "sourceContext": "故去華。答曰。此華不如法是以去之天曰。勿謂此華為"
          },
          {
            "source": "",
            "current": "。",
            "sourceContext": "答曰。此華不如法是以去之天曰。勿謂此華為不如法。"
          },
          {
            "source": "",
            "current": "。",
            "sourceContext": "即皆為來廣說諸佛秘要法藏說已還去。是為七未曾有難"
          },
          {
            "source": "",
            "current": "。",
            "sourceContext": "。幻無定相當何所轉。天曰一切諸法亦復如是無有定相"
          }
        ],
        "actualSourceSmallSupNotes": []
      },
      {
