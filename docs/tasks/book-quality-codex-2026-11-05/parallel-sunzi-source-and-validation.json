      "existingBlocks": 8,
      "htmlSourceBlocks": 8,
      "sameParagraphOrderAndBoundaries": true,
      "bodyReview": "致人、攻守、专分、预定战地与兵形象水八段；反复句不删。",
      "sameBodyExceptSingleDeclaredCharacter": true,
      "notesPresent": 0,
