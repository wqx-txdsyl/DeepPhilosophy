    "currentExisting27DifferenceSpansAllRetained": [
      {
        "chapter": 1,
        "block": 2,
        "source": "，",
        "current": "。",
        "left": "公孫鞅曰：「臣聞之，『疑行無成，疑事無功",
        "right": "』君亟定變法之慮，殆無顧天下之議之也。且"
      },
      {
        "chapter": 3,
        "block": 5,
        "source": "蚵",
        "current": "蚼",
        "left": "農者寡，而遊食者眾，故其國貧危。今夫螟螣",
        "right": "蠋春生秋死，一出而民數年乏食。今一人耕，"
      },
      {
        "chapter": 3,
        "block": 5,
        "source": "軸",
        "current": "詐",
        "left": "紛，則不易使也；信，可以守戰也。壹，則少",
        "right": "而重居；壹，則可以賞罰進也；壹，則可以外"
      },
      {
        "chapter": 3,
        "block": 6,
        "source": "畜",
        "current": "浮",
        "left": "而王可致也。是以明君修政作壹，去無用，止",
        "right": "學事淫之民，壹之農，然後國家可富，而民力"
      },
      {
        "chapter": 4,
        "block": 2,
        "source": "──",
        "current": "，",
        "left": "，有詩有書，有善有修，有孝有弟，有廉有辯",
        "right": "國有十者，上無使戰，必削至亡；國無十者，"
      },
      {
        "chapter": 5,
        "block": 5,
        "source": "疆",
        "current": "彊",
        "left": "。故能生力，能殺力，曰：「攻敵之國」，必",
        "right": "。塞私道以窮其志，啟一門以致其欲，使民必"
      },
      {
        "chapter": 6,
        "block": 4,
        "source": "上",
        "current": "士",
        "left": "。故事詩書談說之士，則民游而輕其上；事處",
        "right": "，則民遠而非其上；事勇士，則民競而輕其禁"
      },
      {
        "chapter": 9,
        "block": 1,
        "source": "──",
        "current": "",
        "left": "非其有，使非其民。明主之所貴，惟爵其實，",
        "right": "爵其實而榮顯之。不榮則不急；列位不顯，則"
      },
      {
        "chapter": 9,
        "block": 3,
        "source": "灸",
        "current": "步",
        "left": "修。故人君者不可不慎己也。夫離朱見秋豪百",
        "right": "之外，而不能以明目易人；烏獲舉千鈞之重，"
      },
      {
        "chapter": 12,
        "block": 1,
        "source": "水",
        "current": "木",
        "left": "無得以助攻備。老弱之軍，使牧牛馬羊彘；草",
        "right": "之可食者，收而食之，以獲其壯男女之食。而"
      },
      {
        "chapter": 13,
        "block": 0,
        "source": "奸",
        "current": "姦",
        "left": "賞戰。求過不求善。故法立而不革，則顯民變",
        "right": "計，奸計止，貴齊殊使，百官之尊爵，厚祿以"
      },
      {
        "chapter": 13,
        "block": 0,
        "source": "奸",
        "current": "姦",
        "left": "求過不求善。故法立而不革，則顯民變奸計，",
        "right": "計止，貴齊殊使，百官之尊爵，厚祿以自伐。"
      },
      {
        "chapter": 16,
        "block": 2,
        "source": "，",
        "current": "。",
        "left": "侍千宮。顛頡後至，請其罪。君曰：「用事焉",
        "right": "」吏遂斷顛頡之脊以殉。晉國之士，稽焉皆懼"
      },
      {
        "chapter": 17,
        "block": 1,
        "source": "疆",
        "current": "彊",
        "left": "。凡戰者，民之所惡也；能使民樂戰者，王。",
        "right": "國之民，父遺其子，兄遺其弟，妻遺其夫，皆"
      },
      {
        "chapter": 17,
        "block": 6,
        "source": "──",
        "current": "。",
        "left": "生。此乃有法之常也。聖王者，不貴義而貴法",
        "right": "法必明，令必行，則已矣。"
      },
      {
        "chapter": 18,
        "block": 2,
        "source": "──",
        "current": "。",
        "left": "爵庶長，就為左更；故爵三更也，就為大良造",
        "right": "皆有賜邑三百家，有賜稅三百家。爵五大夫有"
      },
      {
        "chapter": 18,
        "block": 2,
        "source": "[",
        "current": "〔",
        "left": "勞爵，其縣過三日，有不致士大夫勞爵，能。",
        "right": "其縣四尉，]訾由丞尉，能得甲首一者，賞爵"
      },
      {
        "chapter": 18,
        "block": 2,
        "source": "]",
        "current": "〕",
        "left": "三日，有不致士大夫勞爵，能。[其縣四尉，",
        "right": "訾由丞尉，能得甲首一者，賞爵一級，益田一"
      },
      {
        "chapter": 20,
        "block": 0,
        "source": "──",
        "current": "",
        "left": "狸也，亦不幾乎！故欲戰其民者，必以重法，",
        "right": "賞則必多，威則必嚴；淫道必塞，──為辯知"
      },
      {
        "chapter": 20,
        "block": 0,
        "source": "──",
        "current": "",
        "left": "重法，──賞則必多，威則必嚴；淫道必塞，",
        "right": "為辯知者。不貴，游宦者不任，文學私名不顯"
      },
      {
        "chapter": 20,
        "block": 0,
        "source": "。",
        "current": "",
        "left": "則必多，威則必嚴；淫道必塞，──為辯知者",
        "right": "不貴，游宦者不任，文學私名不顯。賞多威嚴"
      },
      {
        "chapter": 20,
        "block": 1,
        "source": "",
        "current": "，而贏利少",
        "left": "之人利，而游食者眾之謂也。故農之用力最苦",
        "right": "，不如商賈技巧之人。苟能令商賈技巧之人無"
      },
      {
        "chapter": 21,
        "block": 1,
        "source": "──",
        "current": "：",
        "left": "民可令農戰，可令游宦，可令學問。在上所與",
        "right": "上以功勞與，則民戰；上以詩書與，則民學問"
      },
      {
        "chapter": 24,
        "block": 2,
        "source": "軸",
        "current": "詐",
        "left": "一言以枉法；雖有千金，不能以用一銖。故知",
        "right": "賢能者皆作而為善，皆務自治奉公，民愚則易"
      },
      {
        "chapter": 24,
        "block": 3,
        "source": "",
        "current": "兔",
        "left": "亦明矣。一兔走，百人逐之，非以兔也。夫賣",
        "right": "者滿市，而盜不敢取，由名分已定也。故名分"
      },
      {
        "chapter": 24,
        "block": 3,
        "source": "軸",
        "current": "詐",
        "left": "也，為天下師，所以定名分也。名分定，則大",
        "right": "貞信，民皆愿愨，而各自治也。故夫名分定，"
      },
      {
        "chapter": 24,
        "block": 4,
        "source": "──",
        "current": "，",
        "left": "為置法官吏為之師以道之知。萬民皆知所避就",
        "right": "避禍就福，而皆以自治也。故明主因治而治之"
      }
    ],
