    "comparisonDifferencesRetained": [
      {
        "selectedWikisource": "",
        "comparisonCBETA": "王",
        "selectedContext": "山穢惡充滿螺髻梵言仁者心有高下不"
      },
      {
        "selectedWikisource": "仁",
        "comparisonCBETA": "人",
        "selectedContext": "不能救而能救諸疾仁可密速去勿使人聞"
      },
      {
        "selectedWikisource": "為",
        "comparisonCBETA": "謂",
        "selectedContext": "行於平等云何平等為我等涅槃等所以者"
      },
      {
        "selectedWikisource": "烟",
        "comparisonCBETA": "因",
        "selectedContext": "如滅度者受身如無烟之火菩薩觀眾生為"
      },
      {
        "selectedWikisource": "刑",
        "comparisonCBETA": "形",
        "selectedContext": "寶手功德無盡示入刑殘而具諸相好以自"
      },
      {
        "selectedWikisource": "心",
        "comparisonCBETA": "悲",
        "selectedContext": "中有刀兵為之起慈心化彼諸眾生令住無"
      },
      {
        "selectedWikisource": "道",
        "comparisonCBETA": "智",
        "selectedContext": "以欲鉤牽後令入佛道或為邑中主或作商"
      },
      {
        "selectedWikisource": "生",
        "comparisonCBETA": "然",
        "selectedContext": "無生死無縛無解不生不滅如是解者是為"
      },
      {
        "selectedWikisource": "善",
        "comparisonCBETA": "業",
        "selectedContext": "上善菩薩曰身口意善為二是三業皆無作"
      },
      {
        "selectedWikisource": "儩",
        "comparisonCBETA": "𣩠",
        "selectedContext": "飯悉飽眾會猶故不儩其諸菩薩聲聞天人"
      },
      {
        "selectedWikisource": "惓",
        "comparisonCBETA": "倦",
        "selectedContext": "忘教化眾生終不厭惓於四攝法常念順行"
      },
      {
        "selectedWikisource": "葦",
        "comparisonCBETA": "𥯤",
        "selectedContext": "來滿中譬如甘蔗竹葦稻麻叢林若有善男"
      }
    ],
