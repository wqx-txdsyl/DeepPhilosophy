t", "value": "20　愚昧的尊严"}, {"type": "text", "value": "21　致无私的教师"}, {"type": "text", "value": "22　上帝是为国王而存在的"}, {"type": "text", "value": "23　腐化的特征"}, {"type": "text", "value": "24　不同的不满"}, {"type": "text", "value": "25　知识并非先天注定的"}, {"type": "text", "value": "26　什么是生存"}, {"type": "text", "value": "27　自我舍弃者"}, {"type": "text", "value": "28　被至善所伤"}, {"type": "text", "value": "29　危险的说谎者"}, {"type": "text", "value": "30　名人的喜剧"}, {"type": "text", "value": "31　商业与高尚"}, {"type": "text", "value": "32　不受欢迎的门徒"}, {"type": "text", "value": "33　讲堂之外"}, {"type": "text", "value": "34　历史学家的藏匿"}, {"type": "text", "value": "35　异端与巫术"}, {"type": "text", "value": "36　遗言"}, {"type": "text", "value": "37　三种错误的观念"}, {"type": "text", "value": "38　力量爆发的人"}, {"type": "text", "value": "39　改造审美眼光"}, {"type": "text", "value": "40　缺乏高贵风貌"}, {"type": "text", "value": "41　无悔"}, {"type": "text", "value": "42　工作与无聊"}, {"type": "text", "value": "43　法律背叛什么"}, {"type": "text", "value": "44　信念的动机"}, {"type": "text", "value": "45　伊壁鸠鲁"}, {"type": "text", "value": "46　神话比科学更让人惊讶"}, {"type": "text", "value": "47　热情的压抑"}, {"type": "text", "value": "48　苦恼的知识"}, {"type": "text", "value": "49　雅量与相关的性质"}, {"type": "text", "value": "50　孤立的辩论"}, {"type": "text", "value": "51　真实感"}, {"type": "text", "value": "52　别人对我们知道多少"}, {"type": "text", "value": "53　善之源起"}, {"type": "text", "value": "54　表象的意识"}, {"type": "text", "value": "55　什么使人变得高贵"}, {"type": "text", "value": "56　受苦的欲望"}, {"type": "text", "value": "卷二"}, {"type": "text", "value": "57　致实在论者"}, {"type": "text", "value": "58　只能做个创造者"}, {"type": "text", "value": "59　我们艺术家"}, {"type": "text", "value": "60　女人与对远处的影响"}, {"type": "text", "value": "61　向友情致敬"}, {"type": "text", "value": "62　爱情"}, {"type": "text", "value": "63　音乐中的女人"}, {"type": "text", "value": "64　怀疑论者"}, {"type": "text", "value": "65　奉献"}, {"type": "text", "value": "66　弱者的力量"}, {"type": "text", "value": "67　自我掩饰"}, {"type": "text", "value": "68　意志与顺从"}, {"type": "text", "value": "69　报复的能力"}, {"type