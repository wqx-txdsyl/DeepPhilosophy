{"title": "尼采哲学经典（套装共5册）", "index": 107, "content": [{"type": "html", "value": "<body class=\"calibre\">\n<p class=\"calibre_\"><img class=\"calibre_68\" src=\"images/00121.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">巴塞尔大学外景</span></span></p><p class=\"calibre_12\"><img class=\"calibre_69\" src=\"images/00075.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">病中的尼采与母亲</span></span></p><p class=\"calibre_12\"><img class=\"calibre_70\" src=\"images/00082.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">德国哲学家尼采（1844—1900）</span></span></p><p class=\"calibre_12\"><img class=\"calibre_71\" src=\"images/00048.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">德国著名剧作家、作曲家瓦格纳</span></span></p><p class=\"calibre_12\"><img class=\"calibre_72\" src=\"images/00100.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">就读于普福塔高等学校时的尼采（16岁）</span></span></p><p class=\"calibre_12\"><img class=\"calibre_73\" src=\"images/00090.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">尼采15岁时写给母亲的书信手迹</span></span></p><p class=\"calibre_12\"><img class=\"calibre_74\" src=\"images/00113.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">莱比锡大学</span></span></p><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_56\" src=\"images/00032.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_20\" src=\"images/00058.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采的父亲  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采的红粉知己莎乐美  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre_2\"><img class=\"calibre_75\" src=\"images/00088.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">尼采出生地洛肯镇牧师馆</span></span></p><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_76\" src=\"images/00043.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_77\" src=\"images/00059.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采的妹妹伊丽莎白  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采的母亲  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_78\" src=\"images/00024.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_44\" src=\"images/00040.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采的诠释者德国哲学家海德格尔  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采的知音布兰德斯  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_79\" src=\"images/00067.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_56\" src=\"images/00071.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采的墓，德国莱比锡南洛肯小镇教堂墓地  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采曾就读的普福塔高等学校  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre_2\"><img class=\"calibre_80\" src=\"images/00074.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">瓦格纳的家</span></span></p><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_81\" src=\"images/00103.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_81\" src=\"images/00107.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采女友莎乐美  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">任教巴塞尔大学时的尼采  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_44\" src=\"images/00094.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_78\" src=\"images/00038.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">年轻时代的尼采  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">一身戎装的尼采  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre_2\"><img class=\"calibre_82\" src=\"images/00111.jpg\"/>\n</p><p class=\"calibre_83\"><span class=\"calibre3\"><span class=\"bold\">深刻影响了尼采的德国哲学家叔本华（1788—1860）</span></span></p><p class=\"calibre_12\"><img class=\"calibre_84\" src=\"images/00007.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">瓦格纳夫妇</span></span></p><p class=\"calibre_12\"><img class=\"calibre_85\" src=\"images/00031.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">尼采用过的打字机</span></span></p><p class=\"calibre_12\"><img class=\"calibre_86\" src=\"images/00099.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">晚年的尼采</span></span></p><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_78\" src=\"images/00081.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_44\" src=\"images/00010.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">柏拉图  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">古希腊悲剧家埃斯库罗斯  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_87\" src=\"images/00011.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_88\" src=\"images/00063.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">古希腊悲剧家欧里庇得斯  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">古希腊悲剧家索福克勒斯  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_89\" src=\"images/00073.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_44\" src=\"images/00119.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">荷马  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">酒神狄俄尼索斯  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_90\" src=\"images/00061.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_91\" src=\"images/00062.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">人羊神  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">太阳神阿波罗  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre4\" style=\"margin:0pt; border:0pt; height:1em\"> </p><table class=\"calibre_17\" valign=\"top\"><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_78\" src=\"images/00091.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_43\" src=\"images/00069.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">苏格拉底  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">古希腊悲剧演出用的假面具  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><p class=\"calibre_2\"><img class=\"calibre_92\" src=\"images/00079.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">古希腊悲剧演出用的假面具</span></span></p><p class=\"calibre_12\"><img class=\"calibre_93\" src=\"images/00108.jpg\"/>\n</p><p class=\"calibre_83\"><span class=\"calibre3\"><span class=\"bold\">《特里斯坦与依索尔德》　第三幕（拜罗伊特祝祭剧）</span></span></p><p class=\"calibre_12\"><img class=\"calibre_94\" src=\"images/00042.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">拜尔德剧场</span></span></p><p class=\"calibre_12\"><img class=\"calibre_95\" src=\"images/00064.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">德尔菲的女巫</span></span></p><p class=\"calibre_12\"><img class=\"calibre_96\" src=\"images/00124.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">供奉酒神狄俄尼索斯的侍女们</span></span></p><p class=\"calibre_12\"><img class=\"calibre_97\" src=\"images/00046.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">酒神狄俄尼索斯与人羊神们</span></span></p><p class=\"calibre_12\"><img class=\"calibre_98\" src=\"images/00114.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">基督显圣（拉斐尔　画）</span></span></p><p class=\"calibre_12\"><img class=\"calibre_99\" src=\"images/00039.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">舞蹈中的人羊神</span></span></p><p class=\"calibre_12\"><img class=\"calibre_100\" src=\"images/00056.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">骑士、死神、魔鬼（丢勒　绘）</span></span></p><p class=\"calibre_12\"><img class=\"calibre_101\" src=\"images/00060.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">希腊的狄俄尼索斯剧场遗迹</span></span></p><p class=\"calibre_12\"><img class=\"calibre_102\" src=\"images/00023.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">宙斯神殿西边山形墙上的神像群</span></span></p><p class=\"calibre_12\"><img class=\"calibre_103\" src=\"images/00104.jpg\"/>\n</p><p class=\"calibre_11\"><span class=\"calibre3\"><span class=\"bold\">希腊古壶上所绘的酒神狄俄尼索斯</span></span></p><p class=\"calibre_12\"><img class=\"calibre_104\" src=\"images/00117.jpg\"/>\n</p><p class=\"calibre_83\"><span class=\"calibre3\"><span class=\"bold\">马丁·路德的圣诗《神降临我家》（取自1529年初的版本）</span></span></p><p class=\"calibre_12\"><img class=\"calibre_39\" src=\"images/00080.jpg\"/>\n</p><p class=\"calibre_83\"><span class=\"calibre3\"><span class=\"bold\">由于触怒宙斯而遭受兀鹰啄食肝脏的普罗米修斯</span></span></p><p class=\"calibre_12\"><img class=\"calibre_105\" src=\"images/00106.jpg\"/>\n</p><p class=\"calibre_83\"><span class=\"calibre3\"><span class=\"bold\">取自埃斯库罗斯《科基夫奥洛伊》的合唱队群像</span></span></p><div class=\"mbp_pagebreak\" id=\"calibre_pb_106\"></div>\n</body>"}]}