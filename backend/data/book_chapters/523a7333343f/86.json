ibre_19\"><img class=\"calibre_65\" src=\"images/00078.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_66\" src=\"images/00018.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采用过的打字机  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">尼采出生地洛肯镇的牧师馆  </span></span><span class=\"calibre3\">\n</span>\n</td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><img class=\"calibre_67\" src=\"images/00109.jpg\"/> </td><td class=\"calibre_19\"><img class=\"calibre_65\" src=\"images/00001.jpg\"/> </td></tr><tr class=\"calibre_18\" valign=\"top\"><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">病床上的尼采  </span></span><span class=\"calibre3\">\n</span>\n</td><td class=\"calibre_19\"><span class=\"calibre3\">   </span><span class=\"calibre3\"><span class=\"bold\">德国音乐家、歌剧作家瓦格纳  </span></span><span class=\"calibre3\">\n</span>\n</td></tr></table><div class=\"mbp_pagebreak\" id=\"calibre_pb_86\"></div>\n</body>"}]}